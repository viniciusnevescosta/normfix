{
  "name": "normfix-site",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "The normfix browser playground and its documentation, built together.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "web",
    "docs"
  ],
  "overrides": {
    "dompurify@<=3.4.12": "3.4.13",
    "monaco-editor": {
      "dompurify": "3.4.13"
    },
    "vite@<=6.4.2": "6.4.3"
  },
  "scripts": {
    "build": "npm run build --workspace normfix-playground && npm run build --workspace normfix-docs",
    "build:vercel": "npm run build:vercel --workspace normfix-playground && npm run build --workspace normfix-docs",
    "dev": "npm run dev --workspace normfix-playground",
    "docs:dev": "npm run dev --workspace normfix-docs",
    "preview": "npm run preview --workspace normfix-playground",
    "typecheck": "npm run typecheck --workspace normfix-playground",
    "lint": "oxlint web/src web/tests docs/.vitepress",
    "fmt": "oxfmt web/src web/tests docs/.vitepress",
    "fmt:check": "oxfmt --check web/src web/tests docs/.vitepress"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  }
}
