{
  "name": "normfix-playground",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "wasm": "./build.sh",
    "dev": "npm run wasm && npm run typecheck && vite --host 127.0.0.1",
