{
  "name": "normfix-playground",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "wasm": "./scripts/build-wasm.sh",
    "dev": "npm run wasm && npm run typecheck && vite --host 127.0.0.1",
    "build": "npm run wasm && npm run typecheck && vite build",
    "build:vercel": "./scripts/vercel-build.sh",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && vite build"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "monaco-editor": "0.56.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
